          "end" : 5.25,
          "speaker" : "S01",
          "start" : 0.29,
          "text" : "続いての対象戦ですが、甘いモカそして立川来ました。"
        },
        {
          "end" : 6.79,
          "speaker" : "S02",
          "start" : 5.27,
          "text" : "モカさん頑張れ。"
        },
        {
          "end" : 7.82,
          "speaker" : "S03",
          "start" : 6.82,
          "text" : "頑張れ。"
        },
        {
          "end" : 8.86,
          "speaker" : "S04",
          "start" : 8.03,
          "text" : "頑張れ。"
        },
        {
          "end" : 13.11,
          "speaker" : "S01",
          "start" : 8.88,
          "text" : "先ほどはね、立川もプロとしての意地を見せました。"
        },
        {
          "end" : 17.32,
          "speaker" : "S02",
          "start" : 12.61,
          "text" : "CRGTAで人のパンツ覗いてきた人のことなの、ボボボにしてくれ。"
        },
        {
          "end" : 19.64,
          "speaker" : "S04",
          "start" : 17.74,
          "text" : "えー、そうなの？最低だな。"
        },
        {
          "end" : 24.12,
          "speaker" : "S03",
          "start" : 21.62,
          "text" : "私とクロスさんのパンツ覗いてきたから。"
        },
        {
          "end" : 25.82,
          "speaker" : "S04",
          "start" : 24.61,
          "text" : "いや、許せない。"
        },
        {
          "end" : 29.99,
          "speaker" : "S05",
          "start" : 27.24,
          "text" : "立川さんとさ、トトの出会い知って。"
        }
      ],

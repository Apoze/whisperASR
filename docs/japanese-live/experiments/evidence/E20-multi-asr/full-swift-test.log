6)), WhisperASRApp.HighQualityTranslationTurn(id: "unit-0272", japanese: "します。", precedingJapanese: ["それでは1位とですね、こちら実況生から送りしました。"], followingJapanese: ["さあ、まずは話しかけづらさも多少あるんですが、タチカワさん、3先での敗北といういかがでしたか。"], speakerLabel: nil, sourceStart: Optional(802.5600000000001), sourceEnd: Optional(806.48)), WhisperASRApp.HighQualityTranslationTurn(id: "unit-0273", japanese: "さあ、まずは話しかけづらさも多少あるんですが、タチカワさん、3先での敗北といういかがでしたか。", precedingJapanese: ["ステージの平山さん、お願いします。"], followingJapanese: ["2先に勝ちました。"], speakerLabel: nil, sourceStart: Optional(806.86), sourceEnd: Optional(816.4409999999999)), WhisperASRApp.HighQualityTranslationTurn(id: "unit-0274", japanese: "2先に勝ちました。", precedingJapanese: ["さあ、まずは話しかけづらさも多少あるんですが、タチカワさん、3先での敗北といういかがでしたか。"], followingJapanese: ["実際、アマミさんの腕前いかがですか。"], speakerLabel: nil, sourceStart: Optional(816.62), sourceEnd: Optional(821.365)), WhisperASRApp.HighQualityTranslationTurn(id: "unit-0275", japanese: "実際、アマミさんの腕前いかがですか。", precedingJapanese: ["2先に勝ちました。"], followingJapanese: ["そうですね、3つ先って強い方が勝つんですよ。"], speakerLabel: nil, sourceStart: Optional(821.6809999999999), sourceEnd: Optional(825.18)), WhisperASRApp.HighQualityTranslationTurn(id: "unit-0276", japanese: "そうですね、3つ先って強い方が勝つんですよ。", precedingJapanese: ["実際、アマミさんの腕前いかがですか。"], followingJapanese: ["絶対に対応して勝て、俺が対応される側になって、ちょっとリーグとか出てるんじゃないかと思ってましたね。"], speakerLabel: nil, sourceStart: Optional(825.5), sourceEnd: Optional(828.54)), WhisperASRApp.HighQualityTranslationTurn(id: "unit-0277", japanese: "絶対に対応して勝て、", precedingJapanese: ["そうですね、3つ先って強い方が勝つんですよ。"], followingJapanese: ["もしかしたら、本当にそれぐらい上手くて、あと途中で見え隠れするボンさんがきつかったっす。"], speakerLabel: nil, sourceStart: Optional(828.54), sourceEnd: Optional(829.42)), WhisperASRApp.HighQualityTranslationTurn(id: "unit-0278", japanese: "俺が対応される側になって、", precedingJapanese: ["そうですね、3つ先って強い方が勝つんですよ。"], followingJapanese: ["もしかしたら、本当にそれぐらい上手くて、あと途中で見え隠れするボンさんがきつかったっす。"], speakerLabel: nil, sourceStart: Optional(830.22), sourceEnd: Optional(831.74)), WhisperASRApp.HighQualityTranslationTurn(id: "unit-0279", japanese: "ちょっとリーグとか出てるんじゃないかと思ってましたね。", precedingJapanese: ["そうですね、3つ先って強い方が勝つんですよ。"], followingJapanese: ["もしかしたら、本当にそれぐらい上手くて、あと途中で見え隠れするボンさんがきつかったっす。"], speakerLabel: nil, sourceStart: Optional(832.6999999999999), sourceEnd: Optional(837.18)), WhisperASRApp.HighQualityTranslationTurn(id: "unit-0280", japanese: "もしかしたら、本当にそれぐらい上", precedingJapanese: ["絶対に対応して勝て、俺が対応される側になって、ちょっとリーグとか出てるんじゃないかと思ってましたね。"], followingJapanese: ["ああ、タケありました。"], speakerLabel: nil, sourceStart: Optional(837.66), sourceEnd: Optional(839.66)), WhisperASRApp.HighQualityTranslationTurn(id: "unit-0281", japanese: "手くて、あと途中で見え隠れするボンさんがきつかったっす。", precedingJapanese: ["絶対に対応して勝て、俺が対応される側になって、ちょっとリーグとか出てるんじゃないかと思ってましたね。"], followingJapanese: ["ああ、タケありました。"], speakerLabel: nil, sourceStart: Optional(841.18), sourceEnd: Optional(843.5)), WhisperASRApp.HighQualityTranslationTurn(id: "unit-0282", japanese: "ああ、タケありました。", precedingJapanese: ["もしかしたら、本当にそれぐらい上手くて、あと途中で見え隠れするボンさんがきつかったっす。"], followingJapanese: ["マジで、試合で、これ絶对ボンちゃん教えてるみたいなのが3、4個あって、その見え隣に結構やられたなと思って、ちょっとやっぱコーチの優秀さも出てましたね、いや、ちょっとね、タシカワさんがそう言ってますが、モカさんそこはやっぱりありましたか、乗り移ってるところがコーチーの動きが、"], speakerLabel: nil, sourceStart: Optional(843.66), sourceEnd: Optional(845.9)), WhisperASRApp.HighQualityTranslationTurn(id: "unit-0283", japanese: "マジで、試合で、これ絶对ボンちゃん教えてるみたいなのが3、4個あって、", precedingJapanese: ["ああ、タケありました。"], followingJapanese: ["そうですね。"], speakerLabel: nil, sourceStart: Optional(845.9), sourceEnd: Optional(850.54)), WhisperASRApp.HighQualityTranslationTurn(id: "unit-0284", japanese: "その見え隣に結構やられたなと思って、ちょっとやっぱコーチの優秀さも出てましたね、いや、ちょっとね", precedingJapanese: ["ああ、タケありました。"], followingJapanese: ["そうですね。"], speakerLabel: nil, sourceStart: Optional(851.5799999999999), sourceEnd: Optional(858.3)), WhisperASRApp.HighQualityTranslationTurn(id: "unit-0285", japanese: "、タシカワさんがそう言ってますが、モカさんそこはやっぱりありましたか、乗り移ってるところがコーチ", precedingJapanese: ["ああ、タケありました。"], followingJapanese: ["そうですね。"], speakerLabel: nil, sourceStart: Optional(858.14), sourceEnd: Optional(863.18)), WhisperASRApp.HighQualityTranslationTurn(id: "unit-0286", japanese: "ーの動きが、そうですね。", precedingJapanese: ["ああ、タケありました。"], followingJapanese: ["なんかよく似てるって言ってもらえるから、もっと似れるように頑張ります。"], speakerLabel: nil, sourceStart: Optional(863.18), sourceEnd: Optional(865.92)), WhisperASRApp.HighQualityTranslationTurn(id: "unit-0287", japanese: "なんかよく似てるって", precedingJapanese: ["そうですね。"], followingJapanese: ["はい。"], speakerLabel: nil, sourceStart: Optional(866.0), sourceEnd: Optional(866.96)), WhisperASRApp.HighQualityTranslationTurn(id: "unit-0288", japanese: "言ってもらえるから、もっ", precedingJapanese: ["そうですね。"], followingJapanese: ["はい。"], speakerLabel: nil, sourceStart: Optional(868.8), sourceEnd: Optional(870.08)), WhisperASRApp.HighQualityTranslationTurn(id: "unit-0289", japanese: "と似れるように頑張ります。", precedingJapanese: ["そうですね。"], followingJapanese: ["はい。"], speakerLabel: nil, sourceStart: Optional(872.08), sourceEnd: Optional(873.4399999999999)), WhisperASRApp.HighQualityTranslationTurn(id: "unit-0290", japanese: "はい。", precedingJapanese: ["なんかよく似てるって言ってもらえるから、もっと似れるように頑張ります。"], followingJapanese: ["まあでも、あの、あれなんですよ。"], speakerLabel: nil, sourceStart: Optional(873.84), sourceEnd: Optional(874.88)), WhisperASRApp.HighQualityTranslationTurn(id: "unit-0291", japanese: "まあでも、あの、あれなんですよ。", precedingJapanese: ["はい。"], followingJapanese: ["来年のカップコップここなんですよ、またね。"], speakerLabel: nil, sourceStart: Optional(874.88), sourceEnd: Optional(878.64)), WhisperASRApp.HighQualityTranslationTurn(id: "unit-0292", japanese: "来年のカップコップここなんですよ、またね。", precedingJapanese: ["まあでも、あの、あれなんですよ。"], followingJapanese: ["ごくいい感じ。"], speakerLabel: nil, sourceStart: Optional(879.52), sourceEnd: Optional(882.16)), WhisperASRApp.HighQualityTranslationTurn(id: "unit-0293", japanese: "ごくいい感じ。", precedingJapanese: ["来年のカップコップここなんですよ、またね。"], followingJapanese: ["あの、それで向けて、あのアマユイさんからまた一からいろいろ教えていただきながら、頑张いしていただきたいと思います。"], speakerLabel: nil, sourceStart: Optional(882.16), sourceEnd: Opればなと思います。"], f